# cp .env.example .env puis generer une WEBUI_SECRET_KEY.

# Secret de signature des sessions Open WebUI : openssl rand -hex 32
WEBUI_SECRET_KEY=

# ~5 Go, tool-calling natif, confortable sur 64 Go de RAM en CPU seul.
# Alternatives : llama3.1:8b, qwen2.5:7b, mistral:7b, granite3.3:8b
VIVIA_MODEL=qwen3:8b

# Embeddings RAG, servis par Ollama (274 Mo) : aucune dependance a HuggingFace.
VIVIA_EMBED_MODEL=nomic-embed-text

# Port public d'Open WebUI (le seul service joignable depuis l'exterieur).
VIVIA_PORT=3000
