# cp .env.example .env puis generer une WEBUI_SECRET_KEY.

# Secret de signature des sessions Open WebUI : openssl rand -hex 32
WEBUI_SECRET_KEY=

# ~5 Go, tool-calling natif, confortable sur 64 Go de RAM en CPU seul.
# Alternatives : llama3.1:8b, qwen2.5:7b, mistral:7b, granite3.3:8b
VIVIA_MODEL=qwen3:8b

# Embeddings RAG, servis par Ollama (274 Mo) : aucune dependance a HuggingFace.
VIVIA_EMBED_MODEL=nomic-embed-text

# Port public d'Open WebUI (le seul service joignable depuis l'exterieur).
VIVIA_PORT=3000

# DWH Oracle, compte lecture seule (voir src/vivia/oracle/client.py). En reel : le DSN de
# la base de prod. En local contre docker/oracle-test/docker-compose.yml : AGENT/Welcome_1,
# et un DSN joignable depuis le conteneur mcp (pas "localhost", qui designerait mcp lui-meme) :
# host.docker.internal:1521/FREEPDB1 (ajouter `extra_hosts: ["host.docker.internal:host-gateway"]`
# au service mcp sur Linux), ou le nom du service si oracle-test rejoint ce reseau Docker.
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
